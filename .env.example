# =============================================================================
# OpenBuildrOS configuration. Copy to .env (`make env`) and fill in the secrets.
# =============================================================================

# --- Required ----------------------------------------------------------------
# OpenRouter key (https://openrouter.ai/keys). Never sent to the browser.
OPENROUTER_API_KEY=
# Bearer token guarding the AgentOS API. Generate: openssl rand -hex 32
OS_SECURITY_KEY=
# Postgres password for the bundled database. Generate: openssl rand -hex 16
DB_PASSWORD=
# Shared secrets between the backend, the computer supervisor, and bot computers.
COMPUTER_TOKEN=
SUPERVISOR_TOKEN=

# --- UI access ---------------------------------------------------------------
# Set a password to put HTTP Basic auth in front of the whole UI (recommended
# whenever the UI is reachable by anyone but you).
UI_USERNAME=admin
UI_PASSWORD=

# --- Model -------------------------------------------------------------------
# Any OpenRouter model id (provider/model) that supports tool calling.
# Default: anthropic/claude-sonnet-4.5 (DEFAULT_MODEL_ID in backend/app/settings.py).
# OPENROUTER_MODEL_ID=

# Completion token cap per model call (default 4096).
# OPENROUTER_MAX_TOKENS=
# Retries for transient model failures (connection errors, 408/409/429/5xx), with
# exponential backoff + jitter and Retry-After (default 3), and request timeout in seconds.
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_TIMEOUT=120
# Comma-separated models OpenRouter falls back to when the primary is unavailable.
# OPENROUTER_FALLBACK_MODELS=openai/gpt-4o,deepseek/deepseek-chat

# --- Runtime -----------------------------------------------------------------
# prd refuses to start without OPENROUTER_API_KEY and OS_SECURITY_KEY.
# dev relaxes that and enables /docs on the backend.
RUNTIME_ENV=prd
# uvicorn worker processes for the backend. More than 1 requires REDIS_URL so a
# reconnecting client can resume its run on any worker.
WEB_CONCURRENCY=1
# REDIS_URL=redis://redis:6379/0   (start it with: docker compose --profile scale up -d)
# Comma-separated browser origins allowed to call the API directly (the UI does
# not need this; it goes through its server-side proxy).
CORS_ORIGINS=

# --- Bot computers -------------------------------------------------------------
# per-bot: the supervisor starts one isolated container per bot (default).
# shared:  one computer for every bot (start it with --profile shared-computer).
# off:     no computer toolkit.
COMPUTER_MODE=per-bot
# Per-computer limits, idle shutdown, and an optional gVisor runtime ("runsc").
# COMPUTER_MEMORY=2g
# COMPUTER_CPUS=1
# COMPUTER_IDLE_MINUTES=30
# COMPUTER_RUNTIME=
# JSON deny/allow rules for computer actions (see backend/app/policy.py). Default:
# allow everything except browsing private/loopback/metadata addresses.
# COMPUTER_POLICY={"deny": [{"tool": "run_shell", "pattern": "\\brm\\s+-rf\\s+/"}], "allow": [{"tool": "*"}]}

# --- Ports and images --------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_USER=openbuildr
DB_NAME=openbuildr
IMAGE_TAG=latest
